{
  "manifest_version": 2,
  "name": "Rinswa Smart Tab Manager",
  "version": "1.0.0",
  "description": "Smart Tab Management, Auto-Grouping, Duplicate Detection, Sleeping Tabs, and Clean Tabs for Rinswa Browser.",
  "author": "Rinswa",
  "browser_specific_settings": {
    "gecko": {
      "id": "smart-tabs@rinswa.com",
      "strict_min_version": "100.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "tabHide",
    "storage",
    "sessions",
    "contextMenus",
    "alarms",
    "<all_urls>"
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Rinswa Smart Tabs & Clean Tabs",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": ["background.js"]
  }
}
