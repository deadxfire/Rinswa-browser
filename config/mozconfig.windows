# Rinswa Windows Build Configuration
# Target: Windows x64

ac_add_options --enable-application=browser

# Branding directory generated by `build.sh prepare` (must live inside the tree)
ac_add_options --with-branding=browser/branding/rinswa

# Executable / profile naming: produces rinswa.exe and an "Rinswa" install dir
ac_add_options --with-app-name=rinswa
ac_add_options --with-app-basename=Rinswa

# Privacy: no crash reports sent to Mozilla
ac_add_options --disable-crashreporter

# Optimize for release build
ac_add_options --enable-optimize
ac_add_options --disable-debug

# Predictable output folder for the installer
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-rinswa

# Utilize full multi-core performance for parallel compilation
mk_add_options MOZ_MAKE_FLAGS="-j16"
