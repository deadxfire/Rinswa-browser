# Rinswa macOS Build Configuration
# Target: macOS Intel and Apple Silicon (ARM64)

ac_add_options --enable-application=browser

# Point mach to our isolated branding directory
ac_add_options --with-branding=../branding

# Hard-disable Firefox telemetry and data collection
ac_add_options --disable-telemetry
ac_add_options --disable-crashreporter

# Optimize for release build
ac_add_options --enable-optimize
ac_add_options --disable-debug

# macOS specific stripping
ac_add_options --enable-strip
